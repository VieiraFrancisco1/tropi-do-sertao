-card{padding:15px}.admin-stats strong{font-size:18px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}}
@media print{@page{margin:8mm}body{background:white!important;color:black!important;margin:0}body>*{display:none!important}#print-area{display:block!important;position:static!important;width:100%;max-width:80mm;margin:0 auto}#print-area .print-receipt{padding:0;max-width:none;font-size:11px}#print-area .print-receipt hr{border-color:#444}}

/* Compact presentation */
/* New menu items */
.juice-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.juice-card .product-photo img{object-fit:contain}.single-product-grid .product-photo img{object-fit:contain}.sandwich-card .product-photo{background:#ebddc6}
@media(max-width:700px){.juice-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.product-card{display:flex;flex-direction:column;min-width:0}.product-info{display:flex;flex-direction:column;flex:1;min-width:0}.product-info h3{line-height:1.2;overflow-wrap:break-word}.product-info p{flex:1}.product-bottom{margin-top:auto;padding-top:14px}.juice-card .product-photo img{object-position:center}.juice-card .size-badge{background:#d9ff79}.juice-card:nth-child(2){border-color:#97d543;box-shadow:0 0 15px #a5ff3020}.juice-card:nth-child(3){border-color:#ffc33b}.juice-grid .product-info h3{min-height:55px}.single-product-grid .product-card{grid-column:1/-1;display:grid;grid-template-columns:1fr 1.12fr;align-items:stretch}.single-product-grid .product-photo{height:100%;min-height:225px}.single-product-grid .product-info{padding:19px}.single-product-grid .product-info h3{font-size:24px}.single-product-grid .product-info p{margin-top:9px;line-height:1.55}.combo-card{border-color:#8cd62e;background:linear-gradient(115deg,#fff,#f5ffe6);box-shadow:0 0 18px #b4ef3930}.combo-card .size-badge{background:#cfff68}.combo-card .product-photo{background:#eddfc9}.combo-card .product-photo img{object-fit:contain;object-position:center}.combo-section{border-top-color:#9ddb53}.juice-section{border-top-color:#ffbb4e}.builder-product img{flex-shrink:0}.builder-product>div{min-width:0}.builder-combo{background:#f7ffec;border-color:#9ad245}.builder-combo legend b{background:#5d9925}.combo-included{display:grid;gap:8px;margin-top:6px}.combo-included>div{display:flex;align-items:center;gap:9px;padding:11px;background:white;border:1px solid #c6df9d;border-radius:10px}.combo-included>div>span:first-child{display:grid;place-content:center;width:26px;height:26px;background:#dfffad;border-radius:50%;flex-shrink:0}.combo-included svg{width:16px;height:16px}.combo-included>div>span:nth-child(2){flex:1;min-width:0}.combo-included strong{display:block;font-size:12px}.combo-included small{display:block;font-size:10px;color:#7b8c66;margin-top:2px}.combo-included b{font-size:9px;color:#4b8328}.combo-choice-title{font-size:14px;margin:17px 0 11px;line-height:1.6}.combo-choice-title>span{display:block;font-size:9px;color:#b96619;font-weight:400}.combo-juice-choice{display:flex;align-items:center;gap:9px;padding:8px;background:white;border:1px solid #d2e2ba;border-radius:11px;cursor:pointer;margin-bottom:8px}.combo-juice-choice img{width:56px;height:56px;border-radius:8px;flex-shrink:0}.combo-juice-choice>span{flex:1;min-width:0}.combo-juice-choice strong{display:block;font-size:12px;line-height:1.4}.combo-juice-choice small{display:block;font-size:10px;color:#789358;margin-top:3px}.combo-juice-choice input{accent-color:#569720;width:19px;height:19px;flex-shrink:0}.combo-juice-choice:has(input:checked){border-color:#88c630;background:#eaffcd;box-shadow:0 0 11px #acff3020}.combo-selection-help{background:#fff0cc;border:1px solid #ffbe5c;border-radius:9px;padding:10px;font-size:11px;line-height:1.5;color:#946229;margin-top:12px}.combo-selection-help.complete{background:#e6fbcf;border-color:#abd578;color:#4c792c}.bestsellers>p{font-size:10px}
@media(max-width:700px){.juice-grid .product-info h3{min-height:41px}.single-product-grid .product-photo{min-height:178px}.single-product-grid .product-info{padding:13px}.single-product-grid .product-info h3{font-size:19px}.single-product-grid .product-info p{font-size:11px;margin-top:6px}.single-product-grid .product-bottom{padding-top:12px}.builder-product img{width:76px;height:76px}.builder-product p{font-size:11px;line-height:1.6}.combo-section .sub-head h3{font-size:19px}}
@media(max-width:360px){.single-product-grid .product-info{padding:11px}.single-product-grid .product-info h3{font-size:17px}.single-product-grid .product-photo{min-height:178px}.single-product-grid .product-info p{font-size:10px}.juice-grid .product-info h3{min-height:38px}.combo-choice-title{font-size:13px}.combo-juice-choice img{width:47px;height:47px}.combo-juice-choice strong{font-size:11px}.combo-juice-choice small{font-size:9px}}
/* Owner presentation */
.owner-menu>button:nth-child(5){background:#fff7da;border-color:#ffbb39}.owner-menu>button:nth-child(6){background:#eafff5;border-color:#62c89a}.owner-menu>button:nth-child(5) .owner-menu-icon{background:#ffe6a0}.owner-menu>button:nth-child(6) .owner-menu-icon{background:#c5f7df}
.payment-totals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:15px 0}.payment-totals>div{display:flex;align-items:flex-start;gap:7px;padding:12px 9px;border:1px solid #a0d586;border-radius:11px;background:#f1ffe7;min-width:0}.payment-totals>div:nth-child(2){background:#eefbff;border-color:#68c5d4}.payment-totals>div:nth-child(3){background:#f4eeff;border-color:#c0a5ee}.payment-totals svg{width:17px;height:17px;flex-shrink:0}.payment-totals span{font-size:10px;min-width:0}.payment-totals strong{display:block;font-size:14px;letter-spacing:-.5px;white-space:nowrap;margin-top:3px}.bestsellers{padding:0 0 12px;border-bottom:1px solid #e1ead3}.bestsellers h4{font-size:12px;margin:15px 0 8px}.bestsellers>p{font-size:10px;line-height:1.5;color:#6b7d5d;margin-top:10px}.ranking-list{list-style:none;padding:0;margin:0;display:grid;gap:8px}.ranking-list li{display:flex;align-items:center;gap:9px;padding:10px;border:1px solid #f8b148;background:linear-gradient(115deg,#fffad9,#fff3e6);border-radius:10px}.ranking-list li>b{display:grid;place-content:center;width:24px;height:24px;border-radius:7px;background:#ffab36;color:#194e34;font-size:12px}.ranking-list li>span{font-size:12px;font-weight:700;flex:1}.ranking-list li>strong{font-size:15px;white-space:nowrap}.ranking-list small{font-size:9px;font-weight:400}
.cash-hero{position:relative;background:linear-gradient(130deg,#174e34,#297641);color:white;border:1.5px solid #afff48;border-radius:16px;padding:18px;box-shadow:0 0 16px #c1ff4530;margin:0 0 14px;overflow:hidden}.cash-hero:after{content:"";position:absolute;right:-40px;bottom:-60px;width:190px;height:190px;border-radius:50%;border:1px solid #c9ff7340;pointer-events:none;box-shadow:0 0 0 22px #c9ff7308}.cash-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}.cash-icon{display:grid;place-content:center;width:35px;height:35px;background:#d5ff71;border-radius:10px;color:#174e34}.cash-icon svg{width:21px;height:21px}.cash-status{padding:5px 8px;border-radius:7px;color:#d4ff95;background:#b4f34c22;border:1px solid #afff4870;font-size:8px;letter-spacing:.7px;font-weight:700}.cash-status.closed{color:#ffe295;background:#ffe28b18;border-color:#ffe28b60}.cash-hero>small{font-size:8px;letter-spacing:1px;color:#d3f4b6;font-weight:700}.cash-hero>strong{display:block;font-size:35px;letter-spacing:-1.2px;line-height:1.2;margin:5px 0}.cash-hero h3{font-size:25px;letter-spacing:-.8px;line-height:1.15}.cash-hero p{font-size:11px;color:#e0f3d0;margin-top:9px;max-width:280px;line-height:1.6}.cash-live-dot{position:absolute;right:23px;bottom:24px;width:9px;height:9px;background:#bcff42;border-radius:50%;box-shadow:0 0 14px #bdff42;animation:cashPulse 2.5s ease-in-out infinite}.cash-breakdown{background:white;border:1px solid #d1e3bd;border-radius:12px;padding:12px}.cash-breakdown>div{display:flex;justify-content:space-between;gap:10px;font-size:11px;padding:7px 0}.cash-breakdown>div:last-child{border-top:1px solid #e4ecd9;margin-top:5px;padding-top:11px}.cash-form{padding:16px;border:1.5px solid #ffb352;border-radius:14px;background:#fffaf0;margin:16px 0}.cash-form h3{font-size:17px;letter-spacing:-.4px;margin-bottom:12px}.cash-form>.primary,.cash-form>.secondary{margin-top:12px}.cash-form>p{font-size:11px;color:#687b5d;line-height:1.6;margin-bottom:11px}.cash-form-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:10px}.cash-form-grid label{min-width:0;font-size:10px}.cash-form-grid .text-input{margin-top:6px;font-size:12px;width:100%;min-width:0;height:42px}.cash-money-input{display:flex;align-items:center;border:1px solid #d3ddc4;border-radius:10px;background:white;overflow:hidden}.cash-money-input>span{padding-left:12px;font-size:13px;font-weight:700;color:#70815d}.cash-money-input>.text-input{border:0;background:none;min-width:0;flex:1}.cash-money-input:focus-within{outline:2px solid #ff9d22;outline-offset:2px}.cash-close{background:linear-gradient(115deg,#f6ffe2,#fafff6);border-color:#aad45f}.cash-close-preview{padding:9px 10px;border-radius:8px;background:#e8f6d8;font-size:11px;margin-top:11px}.cash-movements article{display:flex;gap:9px;align-items:center;padding:11px 0;border-bottom:1px solid #e3ecd8}.cash-entry-icon{display:grid;place-content:center;background:#eaffd1;color:#468128;border-radius:8px;flex-shrink:0;width:30px;height:30px}.cash-entry-icon svg{width:17px;height:17px}.cash-entry-icon.withdrawal{background:#ffe0e9;color:#ca3962}.cash-entry-icon.sale{background:#fff0cf;color:#d58119}.cash-movements article>div{flex:1;min-width:0}.cash-movements strong{display:block;font-size:11px;overflow-wrap:anywhere}.cash-movements small{display:block;font-size:8px;color:#7d8d6c;margin-top:4px}.cash-movements article>b{font-size:12px;white-space:nowrap}.cash-history{background:white;border:1px solid #c6dfa8;border-radius:13px;padding:14px;margin-bottom:12px}.cash-history>div strong{display:block;font-size:12px}.cash-history small{display:block;font-size:9px;color:#7b8c6c;margin-top:4px}.cash-difference{display:inline-block;padding:4px 7px;border-radius:6px;font-size:9px;margin:9px 0}.cash-difference.balanced{color:#317320;background:#e5f9d5}.cash-difference.unbalanced{color:#ac3552;background:#ffe4eb}.cash-history dl{display:grid;grid-template-columns:1fr auto;gap:7px;font-size:11px;margin:4px 0 13px}.cash-history dd{font-weight:700}.cash-history .secondary{font-size:11px}
.message-stage{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid #9fd274;background:#efffe4;border-radius:12px;margin-bottom:16px}.message-stage>span{display:grid;place-content:center;width:31px;height:31px;border-radius:50%;background:#ccff77}.message-stage svg{width:19px;height:19px}.message-stage strong{display:block;font-size:9px;letter-spacing:.4px}.message-stage small{display:block;font-size:10px;color:#6d7e5b;margin-top:4px}.whatsapp-preview{border:1px solid #c5d8b1;border-radius:15px;overflow:hidden;background:#f0eadf;margin-bottom:17px}.whatsapp-preview-top{display:flex;gap:10px;align-items:center;padding:12px;background:#174e34;color:white}.whatsapp-preview-top img{width:36px;height:36px;border-radius:50%;border:1px solid #ffa13c}.whatsapp-preview-top>span:nth-child(2){flex:1}.whatsapp-preview-top strong{display:block;font-size:13px}.whatsapp-preview-top small{display:block;font-size:9px;color:#b6d8c2;margin-top:3px}.whatsapp-preview-top svg{width:23px;height:23px}.message-bubble{position:relative;margin:20px 14px 24px 26px;background:#dcf7c6;border-radius:0 12px 12px 12px;box-shadow:0 3px 10px #174e3410;padding:14px;animation:messageIn .35s ease-out}.message-bubble:before{content:"";position:absolute;top:0;left:-10px;border-right:10px solid #dcf7c6;border-bottom:10px solid transparent}.message-bubble p{font-size:13px;line-height:1.7;color:#25432a}.message-bubble>span{display:flex;justify-content:flex-end;align-items:center;gap:5px;font-size:8px;color:#698458;margin-top:10px}.message-bubble svg{width:14px;height:14px;color:#5599b7}.message-sheet .demo-notice{font-size:10px;line-height:1.7}.report-controls{flex-wrap:wrap}.report-tabs{flex:1;min-width:190px}.report-tabs button{flex:1;padding-left:8px;padding-right:8px}.report-controls>label{flex-basis:145px;max-width:none}
@keyframes cashPulse{50%{box-shadow:0 0 0 6px #bdff4219,0 0 17px #bdff42}}@keyframes messageIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:700px){.payment-totals>div{padding:10px 7px;gap:5px}.payment-totals svg{width:14px;height:14px}.payment-totals strong{font-size:13px}.cash-form{padding:13px}.cash-hero{padding:16px}.cash-hero>strong{font-size:32px}.cash-form-grid{grid-template-columns:1.2fr 1fr}.report-tabs{min-width:180px}.report-tabs button{font-size:11px}}
@media(max-width:360px){.payment-totals{gap:5px}.payment-totals>div{flex-direction:column}.payment-totals strong{font-size:12px}.cash-form-grid{grid-template-columns:1fr}.report-controls>label{flex-basis:100%}.report-tabs{min-width:0}}
.catalog{padding-top:0}.page-shell{padding-top:16px}.owner-heading{display:flex;align-items:center;gap:12px;padding:14px;border:1.5px solid #ff9000;border-radius:15px;background:linear-gradient(115deg,#174e34,#286841);color:white;margin-bottom:15px;box-shadow:0 0 16px #ff820020}.owner-heading>img{width:48px;height:48px;border-radius:50%;border:2px solid #ffac35;box-shadow:0 0 12px #ff9a0050}.owner-heading h3{font-size:23px;line-height:1.2;letter-spacing:-.6px}.owner-heading p{font-size:11px;color:#e0edce;margin-top:3px}.owner-label{display:inline-block;font-size:8px;letter-spacing:.9px;font-weight:700;color:#d7ff80}.owner-demo{margin-left:auto;align-self:flex-start;background:#d7ff80;color:#174e34;padding:4px 6px;border-radius:6px;font-size:7px;letter-spacing:.5px}.owner-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:19px}.owner-summary>div{padding:10px 8px;border:1px solid #ffba64;border-radius:11px;background:#fff2d8}.owner-summary>div:nth-child(2){border-color:#a7d860;background:#eeffd5}.owner-summary>div:nth-child(3){border-color:#f39ab5;background:#fff0f5}.owner-summary small{display:block;font-size:9px;color:#5e7256;white-space:nowrap}.owner-summary strong{display:block;font-size:19px;line-height:1.4;letter-spacing:-.7px;white-space:nowrap}.owner-section-title{font-size:17px;letter-spacing:-.4px;margin:17px 0 11px}.owner-menu{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.owner-menu>button{position:relative;display:flex;align-items:flex-start;flex-direction:column;gap:6px;min-width:0;text-align:left;padding:14px 12px;border:1.5px solid #ff9c32;border-radius:14px;background:#fff9ed;box-shadow:0 0 12px #ff840012}.owner-menu>button:nth-child(2){background:#f0ffe0;border-color:#a5d05b}.owner-menu>button:nth-child(3){background:#fff1f6;border-color:#f48aab}.owner-menu>button:nth-child(4){background:#f4f1ff;border-color:#b9a2ed}.owner-menu-icon{display:grid;place-content:center;width:31px;height:31px;border-radius:9px;background:#ffdf9d;color:#245036}.owner-menu-icon svg{width:19px;height:19px}.owner-menu>button:nth-child(2) .owner-menu-icon{background:#ddffa4}.owner-menu>button:nth-child(3) .owner-menu-icon{background:#ffd5e4}.owner-menu>button:nth-child(4) .owner-menu-icon{background:#e5dbff}.owner-menu strong{font-size:14px;letter-spacing:-.3px;line-height:1.3}.owner-menu small{font-size:10px;color:#6e7b65;line-height:1.4}.owner-menu>button>svg{position:absolute;right:11px;top:17px;width:15px;height:15px}.owner-menu>button:hover{transform:translateY(-2px);box-shadow:0 4px 14px #184d3420}.owner-status{margin-top:18px;padding:14px;border:1px solid #b7d691;border-radius:13px;background:white}.owner-status h3{font-size:14px;letter-spacing:-.3px;margin-bottom:10px}.owner-status>div{display:grid;grid-template-columns:1fr 1fr;gap:8px}.owner-status span{display:flex;align-items:center;gap:6px;font-size:10px;color:#556b4f}.owner-status svg{width:15px;height:15px;color:#ee8800}.owner-status span:nth-child(2) svg{color:#7960bc}.owner-status span:nth-child(3) svg{color:#168995}.owner-status span:nth-child(4) svg{color:#55932a}.owner-example{margin-top:17px}.owner-example p{font-size:11px;color:var(--muted);margin:0 0 9px}.owner-note{font-size:10px!important;margin-top:17px}.owner-back{display:inline-flex;align-items:center;gap:5px;padding:0 0 13px;font-size:11px;font-weight:700;color:#657e5b}.owner-back svg{width:14px;height:14px}.status-badge.entrega{background:#def9fb;color:#177c88}.order-actions button.order-next,.order-next{display:flex;align-items:center;justify-content:center;gap:6px;background:#e9dcff;border:1px solid #b8a0ed;border-radius:9px;padding:10px 12px;color:#5e4196;font-size:12px;font-weight:700;white-space:normal}.order-actions button.order-next{flex-basis:100%;font-size:12px}.order-next svg{width:17px;height:17px;flex-shrink:0}.order-actions button.order-next.entrega,.order-next.entrega{background:#ddf9fa;border-color:#6bc3c9;color:#176d76}.order-actions button.order-next.concluido,.order-next.concluido{background:#dfffaf;border-color:#95cb46;color:#2b641d}.detail-actions .order-next{grid-column:1/-1}.report-controls{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:15px}.report-tabs{display:flex;padding:4px;border:1px solid #aed277;border-radius:11px;background:#f1f9e7}.report-tabs button{padding:8px 12px;border-radius:8px;font-size:12px}.report-tabs button.active{background:var(--green);color:#e5ffaf;font-weight:700}.report-controls>label{display:block;min-width:0;max-width:190px;flex:1}.report-controls label>span{display:block;font-size:10px;color:#5a7053;margin-bottom:5px}.report-controls input{min-width:0;font-size:12px;padding:8px 9px;height:36px}.report-headline{border:1.5px solid #ff9d23;border-radius:15px;background:linear-gradient(125deg,#fffbc3,#ffedd4);padding:18px;margin-bottom:13px;box-shadow:0 0 12px #ff820013}.report-headline>small{font-size:8px;font-weight:700;letter-spacing:1px;color:#68713a}.report-headline h3{font-size:15px;letter-spacing:-.4px;margin:3px 0 10px;text-transform:capitalize}.report-headline>strong{display:block;font-size:34px;letter-spacing:-1.5px;line-height:1.15}.report-headline p{font-size:10px;color:#65744f;margin-top:6px}.report-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.report-stats>div{padding:12px 10px;background:white;border:1px solid #bad99c;border-radius:11px}.report-stats small{font-size:9px;display:block;color:#6b7d5d}.report-stats strong{font-size:21px;display:block;line-height:1.4;letter-spacing:-.7px;white-space:nowrap}.report-note{font-size:10px;color:#7c846c;line-height:1.5;margin:11px 0 19px}.report-order{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;background:white;border:1px solid #cedeb6;border-radius:12px;padding:12px;margin-bottom:10px}.report-order>div:first-child>strong{font-size:12px}.report-order p{font-size:11px;margin:3px 0;overflow-wrap:anywhere}.report-order small{font-size:9px;color:#819071}.report-order>div:nth-child(2){display:flex;align-items:flex-end;flex-direction:column;gap:6px}.report-order>div:nth-child(2)>strong{font-size:15px;letter-spacing:-.4px}.report-detail{grid-column:1/-1;display:flex;align-items:center;justify-content:flex-end;gap:4px;padding:7px 0 0;border-top:1px solid #edf2e6;font-size:10px;font-weight:700}.report-detail svg{width:13px;height:13px}
