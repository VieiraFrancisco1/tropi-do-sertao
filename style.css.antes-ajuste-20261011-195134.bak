@font-face{font-family:TropiSans;src:url('data:font/woff;base64,') format('woff');font-weight:400;font-display:swap}
@font-face{font-family:TropiSans;src:url('data:font/woff;base64,') format('woff');font-weight:600 900;font-display:swap}
:root{--green:#164c35;--deep:#103b29;--orange:#ff7a00;--lime:#c0ff44;--pink:#ff497e;--ink:#174630;--muted:#687366;--line:#e1e9da;--soft:#f3f8ed;--font:TropiSans,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--neon:0 0 0 1px #ff980025,0 0 17px #ff830020}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:105px}body{margin:0;background:#fcfdf6;color:var(--ink);font:16px/1.5 var(--font);-webkit-tap-highlight-color:transparent}button,input,textarea{font:inherit;color:inherit}button{cursor:pointer;border:0;background:none}button,a{touch-action:manipulation}a{color:inherit;text-decoration:none}button:disabled{opacity:.4;cursor:not-allowed}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #fc7627;outline-offset:3px}img{display:block;max-width:100%;object-fit:cover}h1,h2,h3,p{margin:0}strong,b,h1,h2,h3{font-weight:700}svg{width:22px;height:22px;display:block;flex-shrink:0}[data-icon],[data-fruit]{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}[data-fruit] svg{width:100%;height:100%}[hidden]{display:none!important}fieldset{border:0;margin:0;padding:0;min-width:0}legend{font-size:16px;font-weight:700;padding:0;margin-bottom:12px}.eyebrow{display:block;font-size:10px;letter-spacing:1.15px;font-weight:700;color:#35683b}.skip-link{position:fixed;top:0;left:15px;transform:translateY(-110%);background:white;padding:10px;z-index:200}.skip-link:focus{transform:none}
.site-header{position:sticky;top:0;z-index:40;background:#fffffff7;backdrop-filter:blur(14px);border-bottom:2px solid var(--orange);box-shadow:0 3px 18px #ff780018}.header-inner{max-width:1120px;display:grid;grid-template-columns:1fr 96px 1fr;align-items:center;margin:auto;padding:9px 22px;min-height:98px;gap:12px}.brand{display:flex;flex-direction:column;align-items:center;justify-content:center;justify-self:center;gap:3px}.brand img{width:63px;height:63px;border-radius:50%;box-shadow:0 0 0 2px #ff9000,0 0 14px #ff9c0038}.brand strong{font-size:13px;letter-spacing:-.5px;line-height:1}.brand strong span{color:#ea6c08}.hours-card{justify-self:start;position:relative;display:flex;align-items:center;gap:10px;text-align:left;border:1.5px solid #ff8100;background:linear-gradient(120deg,#fff4d4,#f1ffdf);border-radius:12px;padding:8px 11px;box-shadow:var(--neon);overflow:hidden}.hours-card:after{content:"";position:absolute;inset:0;transform:translateX(-180%) skewX(-25deg);background:linear-gradient(90deg,transparent,#fff9,transparent);animation:hoursShine 6s infinite;pointer-events:none}.hours-card small{display:block;font-size:8px;letter-spacing:.7px;font-weight:700;line-height:1.4}.hours-card strong{font-size:16px;letter-spacing:-.6px;white-space:nowrap}.hours-fruit{width:31px;height:36px;animation:fruitBob 3.4s ease-in-out infinite;transform-origin:bottom}.header-actions{display:flex;gap:12px;align-items:center;justify-content:flex-end}.icon-button{position:relative;width:42px;height:42px;border:1px solid #e7eccc;border-radius:12px;background:#f7fbe9;display:grid;place-content:center}.bag-button{background:#fff1dc;border-color:#ffbe5a}.bag-count{position:absolute;top:-6px;right:-6px;font-size:11px;background:var(--pink);color:white;border:2px solid white;min-width:20px;height:20px;border-radius:50%;display:grid;place-content:center}
.banner{width:100%;position:relative;overflow:hidden;border:2px solid #ff8100;border-top:0;border-radius:0;background:linear-gradient(110deg,#fdff8b,#fff5a3 36%,#ffb338);box-shadow:inset 0 -3px 18px #ff7d001f,0 0 20px #ff810019}.banner-slide{max-width:1076px;margin:auto;display:grid;grid-template-columns:1.2fr 1fr;height:275px;padding:22px 46px 36px;gap:20px;align-items:center;animation:slideIn .5s ease-out}.banner:has(.fresh-slide:not([hidden])){background:linear-gradient(110deg,#ffba38,#ffa726 45%,#ff8317)}.banner-copy{position:relative;z-index:3}.banner h1,.banner h2{font-size:46px;line-height:1.03;letter-spacing:-2px;margin:8px 0 10px}.banner p{font-size:15px;line-height:1.45}.hero-button{display:inline-flex;align-items:center;gap:10px;background:var(--green);color:white;border-radius:40px;padding:10px 18px;font-size:13px;font-weight:700;margin-top:14px;box-shadow:0 4px 0 #103b29,0 6px 20px #1d542423}.hero-button svg{width:16px;height:16px}.hero-button:hover{background:#226745;transform:translateY(-1px)}.banner-visual{position:relative;height:225px;display:grid;place-content:center;min-width:0}.banner-visual:before{content:"";position:absolute;width:215px;height:215px;background:#c0ff447d;border:1px solid #fff8;border-radius:50%;inset:0;margin:auto;box-shadow:0 0 0 13px #fffffd20,0 0 0 28px #fffffd10}.loyalty-photo{position:relative;width:195px;height:201px;border-radius:17px;overflow:hidden;border:4px solid #faffec;transform:rotate(-6deg);box-shadow:0 9px 20px #32551c30;animation:cardFloat 5s ease-in-out infinite}.loyalty-photo img{width:100%;height:100%;object-position:55% 45%}.reward-seal{position:absolute;right:17px;bottom:3px;width:88px;height:88px;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:50%;background:var(--pink);color:white;border:2px dashed white;transform:rotate(7deg);box-shadow:0 0 16px #ff3c8160;line-height:1.2}.reward-seal svg{width:21px;height:21px}.reward-seal b{font-size:22px}.reward-seal small{font-size:10px}.fruit-orbit{position:absolute;left:10px;top:4px;width:52px;height:52px;z-index:2;filter:drop-shadow(0 4px 2px #193a131b);animation:fruitBob 4s ease-in-out infinite}.hero-photo{position:relative;width:176px;height:215px;overflow:hidden;border:4px solid #fffee8;border-radius:19px;transform:rotate(6deg);box-shadow:0 10px 20px #704e1d25}.hero-photo img{height:100%;width:100%;object-position:50% 50%}.fresh-visual:before{background:#ffe66394}.fresh-visual .fruit-orbit{left:auto;right:18px;top:auto;bottom:0}.small-seal{position:absolute;left:22px;top:0;z-index:2;background:#fff9d9;transform:rotate(-7deg);padding:5px 12px;border-radius:20px;font-size:11px;font-weight:700}
.carousel-controls{position:absolute;bottom:3px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:12px;z-index:5}.slide-arrow{display:grid;place-content:center;width:28px;height:28px}.slide-arrow svg{width:17px;height:17px}.slide-dot{position:relative;width:22px;height:28px;padding:0}.slide-dot:before{content:"";width:7px;height:7px;display:block;background:#34703e44;border-radius:50%;margin:auto;transition:.25s}.slide-dot.active:before{background:var(--green);width:20px;border-radius:10px}.carousel-pause{position:absolute;right:13px;bottom:7px;display:grid;place-content:center;width:24px;height:24px;background:#fff5;border-radius:50%;z-index:5}.carousel-pause svg{width:13px;height:13px}.store-strip{min-height:43px;background:#fff7e9;border-bottom:1px solid #ff9c0047;display:flex;align-items:center;justify-content:center;gap:10px;font-size:12px}.store-strip svg{width:15px;height:15px}.store-strip [data-fruit]{width:22px;height:24px}.strip-dot{width:4px;height:4px;background:var(--orange);border-radius:50%;margin:0 3px}
.page-shell{max-width:1040px;margin:auto;padding:22px 24px 50px}.journey{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:12px 15px;border:1.5px solid var(--orange);background:white;border-radius:15px;box-shadow:var(--neon)}.journey a,.journey button{display:flex;align-items:center;gap:11px;text-align:left;min-width:0;padding:0}.journey>a:not(:last-child){border-right:1px solid #e9ebdd}.journey b{width:34px;height:34px;display:grid;place-content:center;background:#ffe2b8;border-radius:10px;font-size:13px;color:#9b4707;flex-shrink:0}.journey>a:nth-child(2) b{background:#e0ffb3;color:#3c6d0a}.journey button b{background:#ffd2e2;color:#98284d}.journey strong{font-size:14px;display:block;white-space:nowrap}.journey small{display:block;color:var(--muted);font-size:11px}.catalog{padding-top:25px}.section-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:16px}.section-head h2{font-size:34px;line-height:1.15;letter-spacing:-1.2px;margin-top:4px}.section-head .eyebrow{color:#628260;font-size:9px}.heading-fruit{width:47px;height:49px;transform:rotate(10deg)}.search-box{display:flex;align-items:center;gap:10px;background:white;border:1px solid #b5cc9d;border-radius:12px;padding:11px 14px}.search-box>span{color:#74856b}.search-box input{border:0;outline:none;background:none;min-width:0;width:100%;font-size:14px;min-height:22px}.search-box input::-webkit-search-cancel-button{display:none}.search-box input::placeholder{color:#8a9384}.search-box button{padding:0}.search-box svg{width:19px;height:19px}.category-tabs{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;white-space:nowrap;padding:15px 1px 7px}.category-tabs::-webkit-scrollbar{display:none}.category{padding:8px 17px;border:1px solid #d3e5c1;border-radius:23px;background:#f0f8e6;font-size:13px;font-weight:700;flex-shrink:0}.category.active{background:var(--green);border-color:var(--green);color:#e1ff99;box-shadow:0 0 12px #8edc2e24}.category:hover:not(.active){background:#e2fdb6}
.menu-section{margin-top:23px;border-top:2px solid #ff8c0066;padding-top:18px;scroll-margin-top:110px}.sub-head{display:flex;align-items:center;gap:10px;margin-bottom:15px}.step-number,.inline-step{display:inline-grid;place-content:center;background:#ff8400;color:#fff;height:33px;width:33px;flex-shrink:0;font-size:13px;border-radius:10px;box-shadow:0 0 12px #ff7e0033}.step-number.pink{background:var(--pink);box-shadow:0 0 12px #ff418833}.sub-head h3{font-size:23px;letter-spacing:-.7px;line-height:1.25}.sub-head p{font-size:12px;color:var(--muted);margin-top:2px}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.product-card{border:2px solid #ff8c00;border-radius:17px;overflow:hidden;background:white;box-shadow:var(--neon);transition:transform .25s}.product-card:nth-child(2){border-color:#ff6a91;box-shadow:0 0 15px #ff3d7c14}.product-card:hover{transform:translateY(-3px)}.product-photo{position:relative;display:block;padding:0;width:100%;height:280px;overflow:hidden;background:#ecedd8}.product-photo img{width:100%;height:100%;object-position:50% 45%;transition:transform .6s}.product-photo:hover img{transform:scale(1.035)}.size-badge{position:absolute;top:12px;left:12px;background:#ffd436;padding:4px 12px;font-size:13px;font-weight:700;border-radius:20px;color:#235023;box-shadow:0 3px 7px #0001}.size-badge.large{background:#fae9ee;color:#b43259}.product-info{padding:17px}.product-info h3{font-size:23px;letter-spacing:-.8px}.product-info p{color:var(--muted);font-size:13px;line-height:1.4;margin-top:4px}.product-bottom{display:flex;justify-content:space-between;align-items:center;gap:6px;margin-top:15px}.product-price small{display:block;color:var(--muted);font-size:11px;line-height:1.2}.product-price strong{font-size:25px;letter-spacing:-.9px;white-space:nowrap}.add-circle{display:grid;place-content:center;flex-shrink:0;width:41px;height:41px;background:#dbff78;color:var(--green);border:1px solid #95d538;border-radius:12px;box-shadow:0 0 10px #b0e94940}.add-circle:hover{background:#baff32}
.club-teaser{position:relative;display:flex;align-items:center;gap:17px;width:100%;text-align:left;overflow:hidden;border:2px solid #ff8200;background:linear-gradient(115deg,#194e35,#0e442b);border-radius:20px;margin:26px 0 9px;padding:20px;color:white;box-shadow:0 0 18px #ff810021;animation:clubGlow 4s ease-in-out infinite}.club-teaser:after{content:"";position:absolute;right:-30px;top:-48px;width:180px;height:180px;background:#b8fa2c12;border:1px solid #c0ff442b;border-radius:50%;pointer-events:none}.club-fruit{width:55px;height:65px;animation:fruitBob 4s ease-in-out infinite;z-index:1}.club-copy{display:flex;flex-direction:column;z-index:1}.club-copy>small{font-size:9px;font-weight:700;letter-spacing:1.2px;color:#dbff74}.club-copy strong{font-size:23px;line-height:1.2;letter-spacing:-.6px;margin:4px 0 7px}.club-copy>span{font-size:12px;line-height:1.4;color:#e2f1cb}.club-arrow{margin-left:auto;align-self:center;background:var(--lime);width:33px;height:33px;border-radius:50%;color:var(--green);z-index:1}.club-arrow svg{width:17px;height:17px}.extra-section{border-top-color:#ff497e5e;margin-top:25px}.extra-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.extra-card{padding:0;background:white;border:1.5px solid #ffa43e;border-radius:14px;overflow:hidden;text-align:left;display:flex;flex-direction:column;box-shadow:0 0 12px #ff820015;transition:transform .25s}.extra-card:nth-child(3n+2){border-color:#fa82a4;box-shadow:0 0 12px #ff3e7714}.extra-card:nth-child(3n){border-color:#98cc50;box-shadow:0 0 12px #a8db3c19}.extra-card:hover{transform:translateY(-3px)}.extra-card>img{width:100%;aspect-ratio:1.25;object-fit:cover}.extra-body{display:flex;flex-direction:column;flex:1;padding:13px}.extra-card h3{font-size:16px;line-height:1.25;min-height:2.5em;letter-spacing:-.3px}.extra-card small{font-size:11px;color:var(--muted);margin:4px 0 10px}.extra-price{display:flex;align-items:center;justify-content:space-between;gap:5px;margin-top:auto}.extra-price strong{font-size:17px;letter-spacing:-.5px}.extra-plus{display:grid;place-content:center;background:#fff0d8;width:27px;height:27px;border-radius:8px}.extra-plus svg{width:16px;height:16px}.empty-search,.empty-state{text-align:center;padding:30px 10px}.empty-state>.empty-icon,.empty-search>span{display:grid;place-content:center;width:65px;height:65px;background:#f0f9e2;border:1.5px solid #adce72;border-radius:19px;margin:0 auto 15px}.empty-state h3,.empty-search h3{font-size:22px}.empty-state p,.empty-search p{font-size:13px;color:var(--muted);margin:7px 0 20px}
.site-footer{display:flex;align-items:center;gap:13px;border-top:2px solid #ff820034;margin-top:38px;padding:24px 0 8px}.site-footer img{border-radius:50%;width:46px;height:46px}.site-footer strong{font-size:18px}.site-footer p{font-size:12px;color:var(--muted)}.footer-actions{display:flex;flex-direction:column;gap:5px;margin-left:auto;font-size:12px;text-align:right}.footer-actions button{text-decoration:underline;text-underline-offset:3px;padding:0;text-align:inherit}.bottom-nav{display:none}.cart-peek{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);width:min(520px,calc(100% - 30px));z-index:45}.cart-peek>button{display:flex;align-items:center;gap:11px;padding:12px 17px;background:var(--green);color:white;width:100%;border:1.5px solid #a5e236;border-radius:15px;box-shadow:0 7px 25px #0e442c30}.cart-peek button>span:nth-child(2){text-align:left;font-size:14px;font-weight:700}.cart-peek small{display:block;font-size:10px;color:#cfedac;font-weight:400}.cart-peek strong{font-size:20px;letter-spacing:-.7px;margin-left:auto;white-space:nowrap}.cart-peek>button>span:last-child svg{width:17px;height:17px}.peek-bag{position:relative;padding-right:5px}.peek-bag b{position:absolute;top:-7px;right:-2px;display:grid;place-content:center;background:var(--orange);min-width:18px;height:18px;border-radius:50%;font-size:10px}
.sheet{border:1.5px solid #ffa033;border-radius:22px;width:520px;max-width:calc(100% - 32px);max-height:90dvh;margin:auto;padding:0;position:fixed;background:#fefff9;color:var(--ink);overflow:hidden;box-shadow:0 30px 100px #092e2655}.sheet[open]{display:flex;flex-direction:column;animation:sheetIn .25s ease-out}.sheet::backdrop{background:#0d291ac4;backdrop-filter:blur(4px)}.sheet-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:21px 23px 17px;border-bottom:1px solid #ff960048;flex-shrink:0;background:#fffef7}.sheet-top h2{font-size:27px;line-height:1.15;letter-spacing:-1px;margin-top:3px}.sheet-top .eyebrow{font-size:9px}.close-button{display:grid;place-content:center;border:1px solid #eee0c7;border-radius:11px;background:#fff4df;width:34px;height:34px;flex-shrink:0}.close-button svg{width:18px;height:18px}.sheet-scroll{min-height:0;overflow-y:auto;overscroll-behavior:contain;flex:1;padding:20px 23px}.sheet-bottom{display:flex;align-items:center;gap:11px;padding:15px 23px;border-top:1px solid #ff960048;background:#fffef8;flex-shrink:0}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:12px;padding:13px 18px;font-size:14px;font-weight:700;border:1.5px solid #427c26;background:var(--green);color:#fff;box-shadow:0 0 10px #a2df3523;min-height:44px}.primary:hover{background:#226741}.primary svg,.secondary svg{width:19px;height:19px}.secondary{background:#f2ffdc;color:var(--green);border-color:#9aca4f;box-shadow:none}.full{width:100%}.text-button{display:block;text-align:center;font-size:13px;font-weight:700;padding:11px;margin:2px auto 0}.add-to-bag{flex:1;justify-content:space-between;gap:6px}.add-to-bag strong{font-size:14px;white-space:nowrap}.qty-control{display:flex;align-items:center;justify-content:center;gap:7px;background:#f7f8ec;border:1px solid #d4e2b9;border-radius:10px;padding:7px 5px;font-size:14px;font-weight:700;flex-shrink:0}.qty-control button{width:26px;height:25px;padding:0;display:grid;place-content:center}.qty-control svg{width:17px;height:17px}.qty-control>span{min-width:17px;text-align:center}
.builder-product{display:flex;align-items:center;gap:13px;margin-bottom:18px}.builder-product img{width:70px;height:80px;border:1px solid #ff9500;border-radius:12px;object-position:50% 50%}.builder-product h3{font-size:17px;line-height:1.25;letter-spacing:-.4px}.builder-product p{font-size:12px;color:var(--muted);margin-top:4px}.builder-product>[data-fruit]{width:34px;height:39px;margin-left:auto}.step-box{border:1px solid #ff9c47;background:#fffaf0;border-radius:14px;padding:14px;margin-bottom:18px}.step-box legend{padding:0 5px;font-size:15px;margin:0}.step-box legend b{background:var(--orange);display:inline-grid;place-content:center;width:24px;height:24px;border-radius:7px;color:white;font-size:11px;margin-right:5px}.builder-extras{border-color:#9dc74f;background:#fafff2}.builder-extras legend b{background:#548818}.notes-step{border-color:#ff98b6;background:#fff5f7}.notes-step .inline-step{background:var(--pink);width:24px;height:24px;font-size:11px;border-radius:7px;margin-right:5px;box-shadow:none}#size-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:7px}.size-choice{position:relative;display:flex;flex-direction:column;padding:12px;border:1px solid #dce6cb;border-radius:11px;background:white;cursor:pointer;gap:1px}.size-choice strong{font-size:18px;letter-spacing:-.5px}.size-choice>span{font-size:13px}.size-choice input{position:absolute;right:10px;top:14px;accent-color:var(--orange);width:16px;height:16px}.size-choice:has(input:checked){border:2px solid var(--orange);padding:11px;background:#fff0d8;box-shadow:0 0 10px #ff840013}.help-text{font-size:12px;color:var(--muted);line-height:1.5;margin-top:8px;margin-bottom:10px}#builder-extras{display:grid;gap:9px}.extra-choice{display:flex;align-items:center;gap:10px;padding:8px;background:white;border:1px solid #d6e5c1;border-radius:10px;cursor:pointer}.extra-choice img{width:42px;height:42px;border-radius:7px;flex-shrink:0}.extra-choice-copy{display:flex;flex-direction:column;min-width:0}.extra-choice strong{font-size:13px;line-height:1.3}.extra-choice small{color:#719154;font-size:12px}.extra-choice input{margin-left:auto;width:19px;height:19px;accent-color:#4c8d16;flex-shrink:0}.extra-choice:has(input:checked){border-color:#71b323;background:#f0ffe3}.extra-choice:has(input:disabled){opacity:.5}.field-label{display:block;font-size:13px;font-weight:700;margin:12px 0 7px}.field-label small{font-size:10px;font-weight:400;color:var(--muted)}.text-input,textarea{display:block;width:100%;border:1px solid #d7e3c8;border-radius:10px;background:white;padding:11px 12px;font-size:14px}textarea{resize:vertical;min-height:67px}.notes-step .field-label{margin:0 0 9px}.reward-notice,.loyalty-checkout{border:1px solid #92c847;background:#f0ffd9;padding:13px;border-radius:11px;font-size:13px;color:#466929;margin:0 0 18px}
.cart-row{display:flex;gap:13px;padding:15px 0;border-bottom:1px solid var(--line)}.cart-row>img{width:65px;height:86px;border-radius:11px;border:1px solid #ffb25c;object-position:50% 48%}.cart-row-main{flex:1;min-width:0}.cart-row h3{font-size:15px;letter-spacing:-.4px;line-height:1.3}.cart-row p{font-size:11px;color:var(--muted);margin-top:4px;overflow-wrap:anywhere}.cart-row-bottom{display:flex;align-items:center;justify-content:space-between;gap:7px;margin-top:10px}.cart-row-bottom>strong{font-size:19px;white-space:nowrap}.cart-row .qty-control{padding:3px;gap:3px}.remove-line{font-size:11px;color:#a35545;text-decoration:underline;padding:0;margin-top:6px}.cart-bottom{padding:18px 23px;border-top:1px solid #ff960048;flex-shrink:0}.cart-total{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px;margin-bottom:15px}.cart-total strong{font-size:24px;letter-spacing:-.8px;white-space:nowrap}#checkout-form{display:flex;flex-direction:column;flex:1;min-height:0}.demo-notice{border:1px solid #ecd396;background:#fff4d9;padding:11px 13px;font-size:11px;line-height:1.5;border-radius:10px;margin:0 0 18px;color:#785524}.checkout-block{border:1px solid #e6debf;border-radius:13px;padding:14px;margin:0 0 20px}.checkout-block h3,.checkout-block legend{font-size:16px;display:flex;align-items:center;gap:9px}.checkout-block legend{padding:0 5px;margin:0}.inline-step{height:25px;width:25px;font-size:11px;border-radius:8px;box-shadow:none}.checkout-block .choice-grid{margin-top:5px}.choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.choice{position:relative;display:flex;align-items:center;gap:8px;justify-content:center;background:white;border:1px solid #d9e3ce;border-radius:10px;padding:13px;cursor:pointer}.choice input{width:15px;height:15px;accent-color:var(--green);margin:0}.choice strong{font-size:13px}.choice:has(input:checked){background:#edffd3;border-color:#8eb943}.choice svg{width:18px;height:18px}.payment-list{display:grid;gap:9px;margin-top:5px}.payment-choice{display:flex;align-items:center;gap:9px;border:1px solid #dfe6d4;background:white;border-radius:10px;padding:11px;cursor:pointer}.payment-choice:has(input:checked){background:#f1ffdb;border-color:#91ba49}.payment-choice input{width:16px;height:16px;accent-color:var(--green);margin:0 2px 0 0}.payment-choice strong{font-size:13px}.payment-choice svg{width:19px;height:19px}.checkout-summary{border:1px solid #ffac47;background:#fff6e3;padding:15px;border-radius:13px;margin-bottom:15px}.checkout-summary h3{font-size:17px;margin-bottom:11px}.summary-line{display:flex;justify-content:space-between;align-items:flex-start;gap:9px;font-size:13px;margin-bottom:10px}.summary-line>span{flex:1;min-width:0}.summary-line small{display:block;font-size:11px;color:var(--muted)}.summary-line strong{white-space:nowrap}.checkout-summary .cart-total{border-top:1px solid #efcc8a;padding-top:12px;margin-top:12px;margin-bottom:0}.loyalty-checkout{display:flex;align-items:center;gap:12px;margin-bottom:10px;font-size:12px}.loyalty-checkout svg{width:27px;height:27px}
.account-heading{display:flex;align-items:center;gap:13px;padding:15px;border-radius:15px;background:#f0ffdb;border:1px solid #acd16f;margin-bottom:19px}.account-avatar{width:43px;height:43px;display:grid;place-content:center;background:var(--green);color:#e5ff90;border-radius:13px;font-size:20px;font-weight:700}.account-heading h3{font-size:21px;letter-spacing:-.5px;line-height:1.2}.account-heading small{font-size:11px;color:var(--muted)}.profile-form{border:1px solid #e5e9d9;border-radius:12px;padding:12px;margin-top:19px}.profile-form h3{font-size:16px}.profile-form .secondary{margin-top:13px}.profile-form .field-label{margin-top:10px}.account-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:18px 0}
.loyalty-card{position:relative;overflow:hidden;padding:21px;border-radius:21px;background:linear-gradient(135deg,#144d32,#083b29);color:#fff;border:2px solid #ff8a00;box-shadow:0 0 19px #ff7e0027;animation:clubGlow 4s ease-in-out infinite}.loyalty-card:before{content:"";position:absolute;right:-50px;top:-100px;width:280px;height:280px;border-radius:50%;background:#aeef4010;border:1px solid #b4ff4130;pointer-events:none}.loyalty-card-top{display:flex;align-items:center;justify-content:space-between;gap:10px;position:relative}.loyalty-card-top small{color:#c9f57b;font-size:9px;font-weight:700;letter-spacing:1.2px}.loyalty-card-top h3{font-size:25px;line-height:1.15;letter-spacing:-.8px;margin-top:4px}.loyalty-card-top>[data-fruit]{height:47px;width:43px;animation:fruitBob 4s infinite}.loyalty-card>p{font-size:12px;line-height:1.5;color:#d9eac2;margin:10px 0 15px;position:relative}.stamp-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;position:relative}.stamp{aspect-ratio:1;display:grid;place-content:center;position:relative;border:1px dashed #b8df674f;border-radius:50%;background:#ffffff09;font-size:13px;color:#aec3a1;min-width:0}.stamp.checked{background:#bdff43;border:1px solid #d8ff87;color:var(--green);box-shadow:0 0 10px #b8ff4526}.stamp svg{width:24px;height:24px}.stamp:last-child{border-color:#ffae37;background:#ff8a0028;color:#ffbc65}.stamp:last-child.checked{background:#ff8b23;color:white}.stamp.just-earned{animation:stampPop 1.15s cubic-bezier(.2,1,.3,1) both;box-shadow:0 0 18px #c0ff4499}.loyalty-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:15px;font-size:11px;color:#d7ecc5;position:relative}.loyalty-meta b{font-size:15px;color:#d9ff86}.loyalty-track{height:5px;border-radius:8px;background:#ffffff1a;margin-top:9px;overflow:hidden}.loyalty-track span{display:block;background:linear-gradient(90deg,#fda442,#c0ff44);height:100%;border-radius:8px;width:var(--progress);transition:width 1.2s ease-out}.reward-ready{background:#ff7f00;color:#fff6e2;padding:11px 12px;border-radius:10px;position:relative;font-size:12px;margin-top:15px}.reward-ready strong{display:block;font-size:17px}.loyalty-card .reward-button{margin-top:12px;background:#c0ff44;color:var(--green);border-color:#c0ff44}
.order-card{border:1.5px solid #ff9b39;background:white;border-radius:14px;padding:15px;margin-bottom:13px}.order-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.order-top strong{font-size:15px}.status-badge{font-size:10px;font-weight:700;border-radius:20px;padding:4px 9px;background:#fff0c2;color:#926004;white-space:nowrap}.status-badge.preparando{background:#e8eaff;color:#6252a2}.status-badge.concluido{background:#e2fac4;color:#4b781c}.status-badge.cancelado{background:#ffe6e9;color:#a24857}.order-date{font-size:11px;color:var(--muted);margin:6px 0 10px}.order-customer{font-size:15px;margin-bottom:5px}.order-items{font-size:12px;color:var(--muted)}.order-items p{margin-top:5px;overflow-wrap:anywhere}.order-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;border-top:1px solid var(--line);padding-top:11px;margin-top:11px;font-size:11px}.order-foot strong{font-size:20px;white-space:nowrap}.order-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}.order-actions button{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1px solid #d4e4bc;border-radius:9px;background:#f4fae8;font-size:12px;font-weight:700;padding:8px 11px;flex:1;white-space:nowrap}.order-actions button.print-button{border-color:#f7b361;background:#fff2d9}.order-actions svg{width:15px;height:15px}.order-note{font-size:10px;color:var(--muted);margin-top:10px}.mini-loyalty{display:flex;align-items:center;justify-content:space-between;gap:10px;border:1px solid #a5cb62;border-radius:12px;background:#f1ffdc;padding:12px;margin-bottom:15px;font-size:12px}.mini-loyalty strong{font-size:16px}.mini-loyalty button{font-weight:700;text-decoration:underline}.admin-sheet{width:730px}.admin-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-bottom:16px}.admin-stats>div{background:#fff1d6;border:1px solid #ffba64;padding:12px;border-radius:12px}.admin-stats>div:nth-child(2){background:#f0ffd5;border-color:#b2d572}.admin-stats>div:nth-child(3){background:#fff0f4;border-color:#f4a0b5}.admin-stats small{display:block;font-size:10px}.admin-stats strong{display:block;font-size:24px;letter-spacing:-1px}.admin-tabs{display:flex;gap:7px;overflow-x:auto;scrollbar-width:none;margin:14px 0 17px}.admin-tabs button{white-space:nowrap;padding:7px 12px;border:1px solid #d9e7c8;border-radius:18px;font-size:11px;flex-shrink:0}.admin-tabs .active{background:var(--green);color:#dcff95;border-color:var(--green)}
.detail-section{padding:14px;border:1px solid #e7e2c9;border-radius:11px;margin:12px 0}.detail-section h3{font-size:16px;margin-bottom:7px}.detail-section p{font-size:13px;margin-top:4px;overflow-wrap:anywhere}.detail-section small{color:var(--muted)}.detail-section .detail-line{padding:10px 0;border-bottom:1px solid #ebeddc}.detail-section .detail-line:last-child{border-bottom:0}.detail-line strong{display:block;font-size:14px}.detail-total{display:flex;justify-content:space-between;align-items:center;font-size:14px;padding:15px;background:#fff2d9;border:1px solid #ffb364;border-radius:12px}.detail-total strong{font-size:25px}.detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.print-receipt{max-width:320px;margin:auto;color:#111;font:13px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;background:white;padding:14px}.print-receipt h3{text-align:center;font:700 22px/1.3 var(--font)}.print-receipt>p{text-align:center;font-size:11px}.print-receipt hr{border:0;border-top:1px dashed #999;margin:14px 0}.print-receipt dl{margin:0;font-size:12px;overflow-wrap:anywhere}.print-receipt dt{font-weight:700;margin-top:7px}.print-receipt dd{margin:0}.print-receipt .print-line{margin:12px 0}.print-line strong{display:block}.print-line small{display:block}.print-line>span{display:flex;justify-content:space-between;gap:8px}.print-receipt .print-total{display:flex;justify-content:space-between;font-weight:700;font-size:16px}.print-footer{text-align:center;font-size:10px;margin-top:15px}#print-area{display:none}
.about-logo{margin:0 auto 15px;border-radius:50%;border:2px solid #ff9100}.about-fact{display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line);padding:14px 0}.about-fact>span:nth-child(2){font-size:11px;color:var(--muted)}.about-fact strong{display:block;font-size:14px;color:var(--ink);margin-top:3px}.about-fact [data-fruit]{width:30px;height:35px;margin-left:auto}#about-dialog .sheet-scroll>h3{text-align:center;font-size:23px;margin-bottom:10px}#about-dialog .sheet-scroll>p:not(.demo-notice){font-size:13px;color:var(--muted)}#about-dialog .demo-notice{margin-top:20px}
.success-sheet{text-align:center}.success-sheet .sheet-top{justify-content:flex-end;border:0;padding-bottom:0}.success-sheet .sheet-scroll{padding-top:0}.success-sheet h2{font-size:28px;line-height:1.12;letter-spacing:-1px;margin:9px 0}.success-sheet .sheet-scroll>p{font-size:12px;color:var(--muted)}.success-receipt{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:#fff1d5;border:1px solid #ffb65c;border-radius:12px;margin:16px 0;font-size:12px}.success-receipt strong{font-size:20px}.success-burst{width:240px;height:92px;position:relative;display:grid;place-content:center;margin:0 auto 5px}.success-icon{width:60px;height:60px;background:#c4ff56;color:#225f26;display:grid;place-content:center;border-radius:50%;border:2px solid #88c925;box-shadow:0 0 25px #adf04150;animation:stampPop .8s ease-out}.success-icon svg{width:29px;height:29px}.success-burst [data-fruit]{position:absolute;width:30px;height:36px;animation:fruitCelebrate 1.25s both}.success-burst [data-fruit]:nth-child(1){left:34px;top:4px;--turn:-20deg}.success-burst [data-fruit]:nth-child(2){right:33px;top:4px;--turn:20deg;animation-delay:.08s}.success-burst [data-fruit]:nth-child(3){right:50px;bottom:0;--turn:-12deg;animation-delay:.16s}.success-burst i{position:absolute;width:6px;height:10px;background:#ff7a00;animation:confettiIn 1.3s both;transform:rotate(20deg);left:20px;top:26px}.success-burst i:nth-of-type(2){left:70px;top:0;background:#ff497e;transform:rotate(-25deg)}.success-burst i:nth-of-type(3){left:auto;right:18px;top:45px;background:#a1da25}.success-burst i:nth-of-type(4){left:65px;top:auto;bottom:10px;background:#f6c629}.success-sheet .loyalty-card{padding:15px;text-align:left;margin:0 0 17px;border-radius:16px}.success-sheet .loyalty-card-top h3{font-size:20px}.success-sheet .loyalty-card>p{margin:6px 0 10px;font-size:10px}.success-sheet .stamp-grid{gap:6px}.success-sheet .stamp{max-height:44px}.success-sheet .stamp svg{width:20px;height:20px}.success-sheet .loyalty-meta{margin-top:10px}.success-sheet .loyalty-card-top>[data-fruit]{width:29px;height:36px}.toast{pointer-events:none;position:fixed;left:50%;bottom:110px;transform:translate(-50%,12px);background:#103b29;color:white;border:1px solid #b7e16b;border-radius:12px;padding:12px 17px;font-size:12px;opacity:0;transition:opacity .2s,transform .2s;z-index:100;max-width:calc(100% - 28px);width:max-content;white-space:normal;text-align:center}.toast.visible{opacity:1;transform:translate(-50%,0)}
@keyframes hoursShine{0%,65%{transform:translateX(-180%) skewX(-25deg)}90%,100%{transform:translateX(180%) skewX(-25deg)}}@keyframes fruitBob{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-4px) rotate(6deg)}}@keyframes cardFloat{0%,100%{transform:translateY(0) rotate(-6deg)}50%{transform:translateY(-5px) rotate(-3deg)}}@keyframes clubGlow{0%,100%{box-shadow:0 0 12px #ff810025}50%{box-shadow:0 0 22px #ff810050}}@keyframes slideIn{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:translateX(0)}}@keyframes sheetIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}@keyframes stampPop{0%{transform:scale(.3) rotate(-20deg);opacity:0}60%{transform:scale(1.17) rotate(7deg);opacity:1}100%{transform:scale(1) rotate(0);opacity:1}}@keyframes fruitCelebrate{from{opacity:0;transform:translateY(35px) scale(.3)}65%{opacity:1;transform:translateY(-4px) scale(1.1) rotate(var(--turn))}to{opacity:1;transform:translateY(0) scale(1) rotate(var(--turn))}}@keyframes confettiIn{from{opacity:0;translate:0 35px}to{opacity:1;translate:0 0}}
@media(max-width:700px){
html{scroll-padding-top:96px}.header-inner{grid-template-columns:1fr 84px 1fr;padding:8px 14px;min-height:90px;gap:7px}.brand img{width:57px;height:57px}.brand strong{font-size:12px}.hours-card{padding:7px 8px;gap:4px;border-radius:10px}.hours-card small{font-size:6.7px;letter-spacing:.4px}.hours-card strong{font-size:12px;letter-spacing:-.3px}.hours-fruit{width:24px;height:29px}.header-actions{gap:7px}.icon-button{width:33px;height:34px;border-radius:10px}.icon-button svg{width:19px;height:19px}
.banner-slide{height:208px;padding:15px 17px 31px;gap:3px;grid-template-columns:1.24fr 1fr}.banner .eyebrow{font-size:7.7px;letter-spacing:.65px;white-space:nowrap}.banner h1,.banner h2{font-size:28px;letter-spacing:-1.2px;line-height:1.05;margin:7px 0 7px}.banner p{font-size:11px;line-height:1.5}.hero-button{padding:8px 12px;font-size:10px;gap:5px;margin-top:10px;min-height:31px}.hero-button svg{width:13px;height:13px}.banner-visual{height:159px;margin-right:-7px}.banner-visual:before{width:135px;height:135px}.loyalty-photo{width:128px;height:149px;border-width:3px;border-radius:13px}.reward-seal{height:59px;width:59px;right:-1px;bottom:-4px;border-width:1.5px}.reward-seal svg{width:15px;height:15px}.reward-seal b{font-size:15px}.reward-seal small{font-size:7px}.fruit-orbit{width:34px;height:40px;top:-6px;left:-4px}.hero-photo{height:154px;width:122px;border-width:3px;border-radius:13px}.small-seal{font-size:8px;padding:4px 8px;left:-3px;top:0}.fresh-visual .fruit-orbit{right:-1px;bottom:-6px}.carousel-controls{gap:5px}.carousel-pause{right:10px}.store-strip{font-size:10px;gap:7px;min-height:39px}.store-strip svg{width:13px;height:13px}.store-strip [data-fruit]{width:18px;height:21px}
.page-shell{padding:16px 16px 106px}.journey{padding:11px 9px;gap:7px;border-radius:13px}.journey a,.journey button{gap:5px}.journey b{width:25px;height:28px;font-size:10px;border-radius:8px}.journey strong{font-size:10px;letter-spacing:-.2px}.journey small{font-size:8px;white-space:nowrap}.catalog{padding-top:22px}.section-head h2{font-size:29px;letter-spacing:-1px}.section-head .eyebrow{font-size:8px}.heading-fruit{width:38px;height:41px}.section-head{margin-bottom:13px}.search-box{padding:10px 12px}.search-box input{font-size:13px}.category-tabs{padding-top:13px;gap:7px;margin-right:-16px;padding-right:16px}.category{font-size:12px;padding:7px 14px}.menu-section{margin-top:18px;padding-top:15px}.sub-head{gap:9px;margin-bottom:13px}.step-number{height:30px;width:30px;font-size:11px;border-radius:9px}.sub-head h3{font-size:19px}.sub-head p{font-size:10px}.product-grid{gap:11px}.product-card{border-width:1.5px;border-radius:14px}.product-photo{height:182px}.size-badge{font-size:10px;padding:4px 10px;left:9px;top:9px}.product-info{padding:11px 11px 13px}.product-info h3{font-size:17px;letter-spacing:-.5px}.product-info p{font-size:11px;line-height:1.45}.product-bottom{margin-top:13px}.product-price small{font-size:10px}.product-price strong{font-size:21px;letter-spacing:-.7px}.add-circle{width:32px;height:33px;border-radius:9px}.add-circle svg{width:18px;height:18px}
.club-teaser{padding:16px 12px;gap:9px;margin-top:23px;border-radius:17px}.club-fruit{width:38px;height:47px}.club-copy strong{font-size:18px;letter-spacing:-.5px}.club-copy>small{font-size:8px}.club-copy>span{font-size:10px;max-width:235px}.club-arrow{width:27px;height:27px}.club-arrow svg{width:15px;height:15px}.extra-section{margin-top:25px}.extra-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.extra-card>img{aspect-ratio:1.35}.extra-body{padding:11px}.extra-card h3{font-size:14px;letter-spacing:-.3px}.extra-card small{font-size:10px}.extra-price strong{font-size:16px}.extra-plus{width:25px;height:25px}
.site-footer{flex-wrap:wrap;gap:11px;margin-top:30px;padding-top:19px}.site-footer strong{font-size:16px}.site-footer p{font-size:11px}.footer-actions{font-size:11px}.site-footer img{width:40px;height:40px}.bottom-nav{display:flex;position:fixed;bottom:0;left:0;right:0;justify-content:space-around;padding:9px 9px max(9px,env(safe-area-inset-bottom));z-index:50;background:#fffffffa;border-top:1.5px solid #ff8b00;box-shadow:0 -3px 18px #ff8b0016;backdrop-filter:blur(14px)}.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;width:25%;font-size:10px;min-height:41px;color:#849076;padding:0}.nav-item svg{width:20px;height:20px}.nav-item.active{color:var(--green);font-weight:700}.nav-icon-wrap{position:relative}.nav-count{position:absolute;right:-7px;top:-5px;min-width:16px;height:16px;border-radius:50%;background:var(--orange);color:white;font-size:9px;display:grid;place-content:center}.cart-peek{bottom:calc(73px + env(safe-area-inset-bottom));max-width:500px}.cart-peek>button{padding:11px 13px;gap:9px}.cart-peek strong{font-size:18px}.cart-peek button>span:nth-child(2){font-size:12px}
.sheet{max-width:100%;width:100%;margin:auto 0 0;max-height:93dvh;border-radius:21px 21px 0 0;border-bottom:0}.sheet-top{padding:19px 18px 15px}.sheet-top h2{font-size:24px}.sheet-top .eyebrow{font-size:8px}.sheet-scroll{padding:17px 18px}.sheet-bottom{padding:13px 18px max(16px,env(safe-area-inset-bottom));gap:9px}.primary,.secondary{font-size:13px;padding:11px 13px}.add-to-bag{font-size:12px}.add-to-bag strong{font-size:13px}.cart-bottom{padding:16px 18px max(18px,env(safe-area-inset-bottom))}.success-sheet .sheet-scroll{padding-bottom:max(26px,env(safe-area-inset-bottom))}.success-sheet h2{font-size:26px}.success-sheet .sheet-top{padding-top:14px}.success-sheet .loyalty-card{padding:13px}.success-sheet .stamp{max-height:42px}.success-sheet .loyalty-card-top h3{font-size:19px}.admin-stats strong{font-size:21px}.admin-stats>div{padding:10px}.loyalty-card{padding:18px}.stamp-grid{gap:7px}.loyalty-card-top h3{font-size:23px}.loyalty-meta{font-size:10px}.account-actions{gap:8px}.account-actions button{font-size:11px;padding:11px 8px}.detail-actions{gap:7px}.detail-actions button{font-size:12px}
}
