rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.token.get('tropiAdmin', false) == true; }
    match /orders/{id} {
      allow read: if owner() || (signedIn() && resource.data.customer.id == request.auth.uid);
      allow write: if false;
    }
    match /customers/{uid} {
      allow read: if owner() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
    match /cashSessions/{id} { allow read: if owner(); allow write: if false; }
    match /messageJobs/{id} { allow read: if owner(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
