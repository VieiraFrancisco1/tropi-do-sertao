{
  "name": "tropisertao-firebase",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs --mode demo",
    "build:firebase": "node scripts/build.mjs --mode firebase",
    "test": "node logic.test.js && node --test functions/test/unit.test.cjs functions/test/loyalty.test.cjs",
    "test:integration": "firebase emulators:exec --project demo-tropisertao --only firestore,auth \"node --test functions/test/integration.test.cjs\"",
    "emulators": "node scripts/emulators.mjs",
    "deploy": "node scripts/deploy.mjs",
    "build:worker": "node scripts/build.mjs --mode worker",
    "test:worker": "node --test worker/test/*.test.cjs",
    "deploy:spark": "node scripts/deploy-spark.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test:worker:live": "node scripts/check-worker-live.mjs"
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.33.0"
  }
}
